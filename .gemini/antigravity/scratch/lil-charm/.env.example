# =========================================================
# LIL CHARM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials
# =========================================================

PORT=3000

# Supabase Credentials (obtain from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Credentials (obtain from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# JWT Authorization Secret for Admin Sessions
JWT_SECRET=lil_charm_super_secret_jwt_key_2026_change_in_production
